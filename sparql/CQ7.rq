PREFIX prolex: <https://example.org/prolexbase/ontology#>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>

SELECT ?pivot ?countryName ?derivative
WHERE {

  ?pivot prolex:hasType prolex:Type_27 .

  # nom anglais du pays
  ?pivot prolex:hasLexicalEntry ?engEntry .

  ?engEntry ontolex:canonicalForm ?engForm .
  ?engForm ontolex:writtenRep ?countryName .

  FILTER(lang(?countryName) = "en")

  # dérivé arabe
  ?pivot prolex:hasLexicalEntry ?derivEntry .

  ?derivEntry ontolex:otherForm ?derivForm .

  ?derivForm prolex:formType "derivative" .

  ?derivForm ontolex:writtenRep ?derivative .

  FILTER(lang(?derivative) = "ar")
}
LIMIT 50
