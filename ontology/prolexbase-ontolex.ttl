@prefix : <https://example.org/prolexbase/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix lime: <http://www.w3.org/ns/lemon/lime#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prolex: <https://example.org/prolexbase/ontology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@base <https://example.org/prolexbase/ontology#> .

<https://example.org/prolexbase/ontology> rdf:type owl:Ontology ;
                                            owl:imports <http://www.w3.org/2004/02/skos/core> ,
                                                        <http://www.w3.org/ns/lemon/ontolex> ;
                                            dcterms:description "Partial and cautious alignment of the Prolexbase core model with OntoLex-Lemon, enriched with examples covering several proper-name types, including Arabic dialectal variants and selected morphological derivatives encoded as otherForm."@en ;
                                            dcterms:title "Prolexbase partial alignment with OntoLex-Lemon"@en .

#################################################################
#    Object Properties
#################################################################

###  https://example.org/prolexbase/ontology#accessibleVia
prolex:accessibleVia rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf skos:related ;
                     rdfs:comment "Weak alignment: accessibleVia is modeled as a specialized associative relation and therefore aligned as a subproperty of skos:related rather than by strict equivalence."@en ;
                     rdfs:label "accessible via"@en .


###  https://example.org/prolexbase/ontology#hasAliasCategory
prolex:hasAliasCategory rdf:type owl:ObjectProperty ;
                        rdfs:domain prolex:LexicalEntry ;
                        rdfs:range prolex:AliasCategory ;
                        rdfs:label "has alias category"@en .


###  https://example.org/prolexbase/ontology#hasCollocation
prolex:hasCollocation rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf owl:topObjectProperty ;
                      rdfs:domain prolex:Pivot ;
                      rdfs:range prolex:Collocation .


###  https://example.org/prolexbase/ontology#hasLanguage
prolex:hasLanguage rdf:type owl:ObjectProperty ;
                   rdfs:domain prolex:LexicalEntry ;
                   rdfs:range prolex:Language ;
                   rdfs:label "has language"@en .


###  https://example.org/prolexbase/ontology#hasLexicalEntry
prolex:hasLexicalEntry rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf ontolex:isDenotedBy ;
                       owl:inverseOf prolex:isLexicalEntryOf ;
                       rdfs:domain prolex:Pivot ;
                       rdfs:range prolex:LexicalEntry ;
                       rdfs:label "has lexical entry"@en .


###  https://example.org/prolexbase/ontology#hasMeronym
prolex:hasMeronym rdf:type owl:ObjectProperty ;
                  owl:inverseOf prolex:isPartOf ;
                  rdfs:domain prolex:Pivot ;
                  rdfs:range prolex:Pivot ;
                  rdfs:label "has meronym"@en .


###  https://example.org/prolexbase/ontology#hasMorphology
prolex:hasMorphology rdf:type owl:ObjectProperty ;
                     rdfs:domain prolex:LexicalEntry ;
                     rdfs:range prolex:Morphology ;
                     rdfs:label "has morphology"@en .


###  https://example.org/prolexbase/ontology#hasMorphologyConstraint
prolex:hasMorphologyConstraint rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf owl:topObjectProperty ;
                               rdfs:domain prolex:AccessibilityContext ;
                               rdfs:range prolex:Morphology .


###  https://example.org/prolexbase/ontology#hasScript
prolex:hasScript rdf:type owl:ObjectProperty ;
                 rdfs:domain prolex:Language ;
                 rdfs:range prolex:Script ;
                 rdfs:label "has script"@en .


###  https://example.org/prolexbase/ontology#hasSynonym
prolex:hasSynonym rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf skos:closeMatch ;
                  rdf:type owl:SymmetricProperty ;
                  rdfs:domain prolex:Pivot ;
                  rdfs:range prolex:Pivot ;
                  rdfs:comment "Weak alignment: synonymy in Prolexbase is treated as a near-equivalence relation between pivots and is therefore aligned conservatively with skos:closeMatch."@en ;
                  rdfs:label "has synonym"@en .


###  https://example.org/prolexbase/ontology#hasTemporalFrequency
prolex:hasTemporalFrequency rdf:type owl:ObjectProperty ;
                            rdfs:domain prolex:LexicalEntry ;
                            rdfs:range prolex:TemporalFrequency ;
                            rdfs:label "has temporal frequency"@en .


###  https://example.org/prolexbase/ontology#hasType
prolex:hasType rdf:type owl:ObjectProperty ;
               rdfs:domain prolex:Pivot ;
               rdfs:range prolex:Type ;
               rdfs:label "has type"@en .


###  https://example.org/prolexbase/ontology#isDialectOf
prolex:isDialectOf rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf owl:topObjectProperty ;
                   rdfs:domain prolex:Dialect ;
                   rdfs:range prolex:Language .


###  https://example.org/prolexbase/ontology#isLexicalEntryOf
prolex:isLexicalEntryOf rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf ontolex:denotes ;
                        rdfs:domain prolex:LexicalEntry ;
                        rdfs:range prolex:Pivot ;
                        rdfs:label "is lexical entry of"@en .


###  https://example.org/prolexbase/ontology#isPartOf
prolex:isPartOf rdf:type owl:ObjectProperty ;
                rdfs:domain prolex:Pivot ;
                rdfs:range prolex:Pivot ;
                rdfs:label "is part of"@en .


#################################################################
#    Data properties
#################################################################

###  https://example.org/prolexbase/ontology#collocationLabel
prolex:collocationLabel rdf:type owl:DatatypeProperty ;
                        rdfs:subPropertyOf owl:topDataProperty ;
                        rdfs:domain prolex:Collocation ;
                        rdfs:range xsd:string .


###  https://example.org/prolexbase/ontology#dialectName
prolex:dialectName rdf:type owl:DatatypeProperty ;
                   rdfs:domain prolex:Dialect ;
                   rdfs:range xsd:string .


###  https://example.org/prolexbase/ontology#frequencyValue
prolex:frequencyValue rdf:type owl:DatatypeProperty ;
                      rdfs:domain prolex:TemporalFrequency ;
                      rdfs:range xsd:float .


###  https://example.org/prolexbase/ontology#genderValue
prolex:genderValue rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf owl:topDataProperty ;
                   rdfs:domain prolex:Morphology ;
                   rdfs:range xsd:string .


###  https://example.org/prolexbase/ontology#languageISO
prolex:languageISO rdf:type owl:DatatypeProperty ;
                   rdfs:domain prolex:Language ;
                   rdfs:range xsd:string .


###  https://example.org/prolexbase/ontology#languageName
prolex:languageName rdf:type owl:DatatypeProperty ;
                    rdfs:domain prolex:Language ;
                    rdfs:range xsd:string .


###  https://example.org/prolexbase/ontology#lexicalLabel
prolex:lexicalLabel rdf:type owl:DatatypeProperty ;
                    rdfs:domain prolex:LexicalEntry ;
                    rdfs:range rdf:langString .


###  https://example.org/prolexbase/ontology#lexicalType
prolex:lexicalType rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf owl:topDataProperty ;
                   rdfs:domain prolex:LexicalEntry ;
                   rdfs:range xsd:string .


###  https://example.org/prolexbase/ontology#numberValue
prolex:numberValue rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf owl:topDataProperty ;
                   rdfs:domain prolex:Morphology ;
                   rdfs:range xsd:string .


###  https://example.org/prolexbase/ontology#personValue
prolex:personValue rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf owl:topDataProperty ;
                   rdfs:domain prolex:Morphology ;
                   rdfs:range xsd:string .


###  https://example.org/prolexbase/ontology#restrictionValue
prolex:restrictionValue rdf:type owl:DatatypeProperty ;
                        rdfs:subPropertyOf owl:topDataProperty ;
                        rdfs:domain prolex:AccessibilityContext ;
                        rdfs:range xsd:integer .


###  https://example.org/prolexbase/ontology#scriptName
prolex:scriptName rdf:type owl:DatatypeProperty ;
                  rdfs:domain prolex:Script ;
                  rdfs:range xsd:string .


###  https://example.org/prolexbase/ontology#tamValue
prolex:tamValue rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf owl:topDataProperty ;
                rdfs:domain prolex:Morphology ;
                rdfs:range xsd:string .


###  https://example.org/prolexbase/ontology#typeLabel
prolex:typeLabel rdf:type owl:DatatypeProperty ;
                 rdfs:domain prolex:Type ;
                 rdfs:range xsd:string .


###  https://example.org/prolexbase/ontology#writtenForm
prolex:writtenForm rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf ontolex:representation ;
                   rdfs:domain prolex:LexicalEntry ;
                   rdfs:range rdf:langString .


###  https://example.org/prolexbase/ontology#yearValue
prolex:yearValue rdf:type owl:DatatypeProperty ;
                 rdfs:domain prolex:TemporalFrequency ;
                 rdfs:range xsd:integer .


#################################################################
#    Classes
#################################################################

###  https://example.org/prolexbase/ontology#AccessibilityContext
prolex:AccessibilityContext rdf:type owl:Class ;
                            rdfs:label "AccessibilityContext"@en .


###  https://example.org/prolexbase/ontology#Alias
prolex:Alias rdf:type owl:Class ;
             rdfs:subClassOf prolex:LexicalEntry .


###  https://example.org/prolexbase/ontology#AliasCategory
prolex:AliasCategory rdf:type owl:Class ;
                     rdfs:label "AliasCategory"@en .


###  https://example.org/prolexbase/ontology#Collocation
prolex:Collocation rdf:type owl:Class ;
                   rdfs:label "Collocation"@en .


###  https://example.org/prolexbase/ontology#Derivative
prolex:Derivative rdf:type owl:Class ;
                  rdfs:subClassOf prolex:LexicalEntry .


###  https://example.org/prolexbase/ontology#Dialect
prolex:Dialect rdf:type owl:Class ;
               rdfs:label "Dialect"@en .


###  https://example.org/prolexbase/ontology#Idiom
prolex:Idiom rdf:type owl:Class ;
             rdfs:subClassOf prolex:LexicalEntry .


###  https://example.org/prolexbase/ontology#Instance
prolex:Instance rdf:type owl:Class ;
                rdfs:subClassOf prolex:LexicalEntry .


###  https://example.org/prolexbase/ontology#Language
prolex:Language rdf:type owl:Class ;
                rdfs:label "Language"@en .


###  https://example.org/prolexbase/ontology#LexicalEntry
prolex:LexicalEntry rdf:type owl:Class ;
                    rdfs:subClassOf ontolex:LexicalEntry ;
                    rdfs:comment "LexicalEntry represents the lexical realization of a Prolexbase pivot in a given language."@en ;
                    rdfs:label "LexicalEntry"@en .


###  https://example.org/prolexbase/ontology#Morphology
prolex:Morphology rdf:type owl:Class ;
                  rdfs:label "Morphology"@en .


###  https://example.org/prolexbase/ontology#Pivot
prolex:Pivot rdf:type owl:Class ;
             rdfs:subClassOf skos:Concept ,
                             ontolex:LexicalConcept ;
             rdfs:comment "Pivot represents a language-independent conceptual node in Prolexbase used to connect multilingual lexical entries referring to the same proper-name entity. It is aligned as a subclass of ontolex:LexicalConcept for interoperability purposes, while remaining specific to the Prolexbase model. The additional alignment to skos:Concept highlights its multilingual conceptual role."@en ;
             rdfs:label "Pivot"@en .


###  https://example.org/prolexbase/ontology#Prolexeme
prolex:Prolexeme rdf:type owl:Class ;
                 rdfs:subClassOf prolex:LexicalEntry .


###  https://example.org/prolexbase/ontology#Script
prolex:Script rdf:type owl:Class ;
              rdfs:label "Script"@en .


###  https://example.org/prolexbase/ontology#TemporalFrequency
prolex:TemporalFrequency rdf:type owl:Class ;
                         rdfs:label "TemporalFrequency"@en .


###  https://example.org/prolexbase/ontology#Terminology
prolex:Terminology rdf:type owl:Class ;
                   rdfs:subClassOf prolex:LexicalEntry .


###  https://example.org/prolexbase/ontology#Type
prolex:Type rdf:type owl:Class ;
            rdfs:label "Type"@en .


#################################################################
#    Individuals
#################################################################

###  https://example.org/prolexbase/ontology#Dialect_AlgerianArabic
prolex:Dialect_AlgerianArabic rdf:type owl:NamedIndividual ,
                                       prolex:Dialect ;
                              prolex:dialectName "Algerian Arabic" .


