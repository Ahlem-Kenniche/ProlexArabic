###  https://example.org/prolexbase/ontology#Language_AR
prolex:Language_AR rdf:type owl:NamedIndividual ,
                            prolex:Language ;
                   prolex:hasScript prolex:Script_Arabic ;
                   prolex:languageISO "ar" ;
                   prolex:languageName "Arabic" .


###  https://example.org/prolexbase/ontology#Language_EN
prolex:Language_EN rdf:type owl:NamedIndividual ,
                            prolex:Language ;
                   prolex:hasScript prolex:Script_Latin ;
                   prolex:languageISO "en" ;
                   prolex:languageName "English" .


###  https://example.org/prolexbase/ontology#Language_FR
prolex:Language_FR rdf:type owl:NamedIndividual ,
                            prolex:Language ;
                   prolex:hasScript prolex:Script_Latin ;
                   prolex:languageISO "fr" ;
                   prolex:languageName "French" .


###  https://example.org/prolexbase/ontology#LexicalEntry_AR_Abbassiyun
prolex:LexicalEntry_AR_Abbassiyun rdf:type owl:NamedIndividual ,
                                           prolex:LexicalEntry ;
                                  ontolex:canonicalForm prolex:Form_AR_Abbassiyun ;
                                  ontolex:otherForm prolex:Form_AR_Abbassiyun_Alt ;
                                  prolex:hasLanguage prolex:Language_AR ;
                                  prolex:isLexicalEntryOf prolex:Pivot_Abbasids ;
                                  prolex:lexicalLabel "العباسيون"@ar .


###  https://example.org/prolexbase/ontology#LexicalEntry_AR_Abdelkader
prolex:LexicalEntry_AR_Abdelkader rdf:type owl:NamedIndividual ,
                                           prolex:LexicalEntry ;
                                  ontolex:canonicalForm prolex:Form_AR_Abdelkader ;
                                  ontolex:otherForm prolex:Form_AR_Abdelkader_Alt ;
                                  prolex:hasLanguage prolex:Language_AR ;
                                  prolex:isLexicalEntryOf prolex:Pivot_Abdelkader ;
                                  prolex:lexicalLabel "الأمير عبد القادر"@ar .


###  https://example.org/prolexbase/ontology#LexicalEntry_AR_AhmedBenBella
prolex:LexicalEntry_AR_AhmedBenBella rdf:type owl:NamedIndividual ,
                                              prolex:LexicalEntry ;
                                     ontolex:canonicalForm prolex:Form_AR_AhmedBenBella ;
                                     ontolex:otherForm prolex:Form_AR_AhmedBenBella_Alt ;
                                     prolex:hasLanguage prolex:Language_AR ;
                                     prolex:isLexicalEntryOf prolex:Pivot_AhmedBenBella ;
                                     prolex:lexicalLabel "أحمد بن بلة"@ar .


###  https://example.org/prolexbase/ontology#LexicalEntry_AR_AlNil
prolex:LexicalEntry_AR_AlNil rdf:type owl:NamedIndividual ,
                                      prolex:LexicalEntry ;
                             ontolex:canonicalForm prolex:Form_AR_AlNil ;
                             prolex:hasLanguage prolex:Language_AR ;
                             prolex:isLexicalEntryOf prolex:Pivot_Nile ;
                             prolex:lexicalLabel "النيل"@ar .


###  https://example.org/prolexbase/ontology#LexicalEntry_AR_AlQahira
prolex:LexicalEntry_AR_AlQahira rdf:type owl:NamedIndividual ,
                                         prolex:LexicalEntry ;
                                ontolex:canonicalForm prolex:Form_AR_AlQahira ;
                                ontolex:otherForm prolex:Form_AR_AlQahira_Alt ;
                                prolex:hasLanguage prolex:Language_AR ;
