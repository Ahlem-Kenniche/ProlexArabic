prolex:Form_Safavid_ar ontolex:writtenRep "السلالة الصفوية"@ar .

# CQ8: accessibility fixture.
prolex:Pivot_45415 a prolex:Pivot ; prolex:accessibleVia prolex:Pivot_Afghanistan .
prolex:Pivot_Afghanistan a prolex:Pivot ; prolex:hasType prolex:Type_27 ; prolex:hasLexicalEntry prolex:Entry_Afghanistan_en .
prolex:Entry_Afghanistan_en ontolex:canonicalForm prolex:Form_Afghanistan_en .
prolex:Form_Afghanistan_en ontolex:writtenRep "Afghanistan"@en .
